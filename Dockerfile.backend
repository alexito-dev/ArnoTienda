FROM node:20-alpine
WORKDIR /app

RUN apk add --no-cache python3 make g++ sqlite

COPY server/package*.json ./
RUN npm install

COPY server/ ./

RUN mkdir -p /app/data

EXPOSE 3008

ENV PORT=3008
ENV DB_PATH=/app/data/database.sqlite
ENV BUNAISTORE_API_KEY=Shop::2WR8PHImP8Njh3kHI6twuz2AWF8

CMD ["node", "server.js"]
